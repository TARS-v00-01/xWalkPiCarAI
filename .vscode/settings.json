{
    "C_Cpp.errorSquiggles": "enabled",
    "C_Cpp.default.configurationProvider": "",
    "files.associations": {
        "*.h": "cpp"
    },
    "cmake.sourceDirectory": "${workspaceFolder}/xWalk-rpi5-hw",
    "cmake.configureOnOpen": true,
    "cmake.useCMakePresets": "always",
    "github-actions.remote-name": "github-actions",
    "github-actions.workflows.pinned.refresh.enabled": false,
    "github-actions.workflows.pinned.workflows": [
        ".github/workflows/host-quality.yml"
    ],
    "C_Cpp.intelliSenseEngine": "default",
    "C_Cpp.files.exclude": {
        "**/.git": true,
        "**/build-host/controller-boot": true
    }
}
