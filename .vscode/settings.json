{
    "C_Cpp.intelliSenseCacheSize": 0,
    "C_Cpp.errorSquiggles": "enabled",
    "C_Cpp.default.configurationProvider": "",
    "files.associations": {
        "*.h": "cpp"
    },
    "cmake.sourceDirectory": "${workspaceFolder}/xWalk-rpi5-hw",
    "cmake.configureOnOpen": true,
